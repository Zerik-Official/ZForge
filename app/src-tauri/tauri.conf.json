{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZForge",
  "version": "0.1.0",
  "identifier": "com.zforge.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZForge",
        "width": 1208,
        "height": 722,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#07070b"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/assets/custom/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
