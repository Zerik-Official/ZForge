{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZForge",
  "version": "0.0.1",
  "identifier": "com.zforge.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZForge",
        "width": 1208,
        "height": 722,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#07070b"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/assets/custom/**",
          "$APPDATA/themes/**",
          "$APPDATA/resources/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzNDQ5NEUyMjhEMkY2QzkKUldUSjl0SW80cFJFWXpxYnFyZm1Rb0hQcWtJVWNXV3h3bk5maDBTb0hyV0RkV2QyVzZxV3FOSngK",
      "endpoints": [
        "https://github.com/Zerik-Official/ZForge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
